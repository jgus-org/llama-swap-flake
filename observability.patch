@@ -0,0 +1,69 @@
+package process
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestProcessCommand_ReadyForwardingDoesNotRefreshLiveness(t *testing.T) {
+	p := &ProcessCommand{id: "observability"}
+	p.lastUse.Store(123)
+	p.inflight.Store(2)
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if p.lastUse.Load() != 123 || p.inflight.Load() != 2 {
+			t.Error("observation changed process liveness bookkeeping")
+		}
+		w.WriteHeader(http.StatusOK)
+	})
+	p.handler.Store(&handler)
+	for _, method := range []string{http.MethodGet, http.MethodHead} {
+		w := httptest.NewRecorder()
+		p.serveReady(w, httptest.NewRequest(method, "/metrics", nil), StateReady)
+		if w.Code != http.StatusOK {
+			t.Fatalf("status=%d", w.Code)
+		}
+		if p.lastUse.Load() != 123 || p.inflight.Load() != 2 {
+			t.Fatal("completed observation changed process liveness bookkeeping")
+		}
+	}
+	ordinary := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if p.inflight.Load() != 3 {
+			t.Error("ordinary request did not update inflight bookkeeping")
+		}
+		w.WriteHeader(http.StatusOK)
+	})
+	p.handler.Store(&ordinary)
+	p.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/props", nil))
+	if p.inflight.Load() != 2 || p.lastUse.Load() == 123 {
+		t.Fatal("ordinary request did not restore inflight and refresh lastUse")
+	}
+}
+
+func TestProcessCommand_ReadyForwardingRejectsUnready(t *testing.T) {
+	for _, state := range []ProcessState{StateStopped, StateStarting, StateStopping, StateShutdown} {
+		t.Run(string(state), func(t *testing.T) {
+			p := &ProcessCommand{id: "observability"}
+			p.lastUse.Store(123)
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("unready observation reached handler") })
+			p.handler.Store(&handler)
+			w := httptest.NewRecorder()
+			p.serveReady(w, httptest.NewRequest(http.MethodGet, "/metrics", nil), state)
+			if w.Code != http.StatusServiceUnavailable || p.inflight.Load() != 0 || p.lastUse.Load() != 123 {
+				t.Fatalf("unready status=%d inflight=%d lastUse=%d", w.Code, p.inflight.Load(), p.lastUse.Load())
+			}
+		})
+	}
+}
+
+func TestProcessCommand_ServeReadyHTTPRejectsStoppedProcess(t *testing.T) {
+	p := &ProcessCommand{id: "observability"}
+	p.lastUse.Store(123)
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("observation forwarded from an unready process") })
+	p.handler.Store(&handler)
+	w := httptest.NewRecorder()
+	p.ServeReadyHTTP(w, httptest.NewRequest(http.MethodGet, "/metrics", nil))
+	if w.Code != http.StatusServiceUnavailable || p.inflight.Load() != 0 || p.lastUse.Load() != 123 {
+		t.Fatalf("status=%d inflight=%d lastUse=%d", w.Code, p.inflight.Load(), p.lastUse.Load())
+	}
+}
