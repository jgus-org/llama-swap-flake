@@ -0,0 +1,85 @@
+package router
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/mostlygeek/llama-swap/internal/config"
+	"github.com/mostlygeek/llama-swap/internal/process"
+	"github.com/mostlygeek/llama-swap/internal/swaputil"
+)
+
+type observabilityProcess struct{ *fakeProcess }
+
+func (p *observabilityProcess) ServeReadyHTTP(w http.ResponseWriter, r *http.Request) {
+	p.serveCalls.Add(1)
+	w.WriteHeader(http.StatusOK)
+}
+
+func observabilityRequest(method string) *http.Request {
+	r := httptest.NewRequest(method, "/metrics", nil)
+	return r.WithContext(swaputil.SetContext(r.Context(), swaputil.ReqContextData{Model: "a", ModelID: "a", Metadata: make(map[string]string)}))
+}
+
+func TestBaseRouter_ReadyForwardingBypassesAdmission(t *testing.T) {
+	p := &observabilityProcess{newFakeProcess("a")}
+	p.markReady()
+	p.serveBlock = make(chan struct{})
+	b := newTestBaseWithConfig(t, config.Config{Models: map[string]config.ModelConfig{"a": {ConcurrencyLimit: 1}}}, map[string]process.Process{"a": p}, &stubPlanner{})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		b.ServeHTTP(httptest.NewRecorder(), newRequest("a"))
+	}()
+	defer func() { close(p.serveBlock); <-done }()
+	<-p.serveStarted
+	rejected := httptest.NewRecorder()
+	b.ServeHTTP(rejected, newRequest("a"))
+	if rejected.Code != http.StatusTooManyRequests {
+		t.Fatalf("inference status=%d", rejected.Code)
+	}
+	for _, method := range []string{http.MethodGet, http.MethodHead} {
+		w := httptest.NewRecorder()
+		b.ServeReadyHTTP(w, observabilityRequest(method))
+		if w.Code != http.StatusOK {
+			t.Fatalf("%s status=%d", method, w.Code)
+		}
+	}
+	if p.runCalls.Load() != 0 || p.stopCalls.Load() != 0 {
+		t.Fatal("ready forwarding changed process lifecycle")
+	}
+}
+
+func TestBaseRouter_ReadyForwardingRejectsUnready(t *testing.T) {
+	for _, state := range []process.ProcessState{process.StateStopped, process.StateStarting, process.StateStopping, process.StateShutdown} {
+		t.Run(string(state), func(t *testing.T) {
+			p := newFakeProcess("a")
+			p.setState(state)
+			b := newTestBase(t, map[string]process.Process{"a": p}, &stubPlanner{})
+			w := httptest.NewRecorder()
+			b.ServeReadyHTTP(w, observabilityRequest(http.MethodGet))
+			if w.Code != http.StatusConflict {
+				t.Fatalf("status=%d", w.Code)
+			}
+			if p.runCalls.Load() != 0 || p.stopCalls.Load() != 0 || p.serveCalls.Load() != 0 {
+				t.Fatal("unready forwarding touched the process")
+			}
+		})
+	}
+}
+
+func TestBaseRouter_ReadyForwardingRejectsShutdown(t *testing.T) {
+	p := newFakeProcess("a")
+	p.markReady()
+	b := newTestBase(t, map[string]process.Process{"a": p}, &stubPlanner{})
+	if err := b.Shutdown(time.Second); err != nil {
+		t.Fatal(err)
+	}
+	w := httptest.NewRecorder()
+	b.ServeReadyHTTP(w, observabilityRequest(http.MethodGet))
+	if w.Code < 500 || p.serveCalls.Load() != 0 {
+		t.Fatalf("shutdown status=%d serveCalls=%d", w.Code, p.serveCalls.Load())
+	}
+}
