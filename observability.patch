+package config
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestConfig_ObservabilityPaths(t *testing.T) {
+	for _, tc := range []struct {
+		yaml  string
+		paths []string
+	}{
+		{upstreamConfigHeader, nil},
+		{"upstream: {}\n" + upstreamConfigHeader, nil},
+		{"upstream:\n  observabilityPaths: [/metrics, /health]\n" + upstreamConfigHeader, []string{"/metrics", "/health"}},
+	} {
+		cfg, err := LoadConfigFromReader(strings.NewReader(tc.yaml))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(cfg.Upstream.ObservabilityPaths, tc.paths) {
+			t.Fatalf("paths=%v expected=%v", cfg.Upstream.ObservabilityPaths, tc.paths)
+		}
+	}
+}
