diff --git a/internal/server/observability_test.go b/internal/server/observability_test.go
new file mode 100644
index 0000000..f5356a1
--- /dev/null
+++ b/internal/server/observability_test.go
@@ -0,0 +1,57 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/mostlygeek/llama-swap/internal/config"
+)
+
+func TestServer_UpstreamObservabilityRouting(t *testing.T) {
+	for _, tc := range []struct {
+		name, method, path, key string
+		paths                   []string
+		status                  int
+	}{
+		{"metrics", http.MethodGet, "/upstream/m1/metrics", "secret", []string{"/metrics", "/health"}, http.StatusOK},
+		{"head", http.MethodHead, "/upstream/m1/metrics", "secret", []string{"/metrics"}, http.StatusOK},
+		{"health", http.MethodGet, "/upstream/m1/health", "secret", []string{"/health"}, http.StatusOK},
+		{"query", http.MethodGet, "/upstream/m1/metrics?name=foo", "secret", []string{"/metrics"}, http.StatusOK},
+		{"missing key", http.MethodGet, "/upstream/m1/metrics", "", []string{"/metrics"}, http.StatusUnauthorized},
+		{"wrong key", http.MethodGet, "/upstream/m1/metrics", "wrong", []string{"/metrics"}, http.StatusUnauthorized},
+		{"post", http.MethodPost, "/upstream/m1/metrics", "secret", []string{"/metrics"}, http.StatusTooManyRequests},
+		{"trailing slash", http.MethodGet, "/upstream/m1/metrics/", "secret", []string{"/metrics"}, http.StatusTooManyRequests},
+		{"lookalike", http.MethodGet, "/upstream/m1/metrics-extra", "secret", []string{"/metrics"}, http.StatusTooManyRequests},
+		{"inference", http.MethodPost, "/upstream/m1/v1/chat/completions", "secret", []string{"/metrics"}, http.StatusTooManyRequests},
+		{"default unchanged", http.MethodGet, "/upstream/m1/metrics", "secret", nil, http.StatusTooManyRequests},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			local := newStubRouter([]string{"m1"}, "")
+			ordinary, ready := 0, 0
+			local.serveHTTP = func(w http.ResponseWriter, r *http.Request) { ordinary++; w.WriteHeader(http.StatusTooManyRequests) }
+			local.readyHTTP = func(w http.ResponseWriter, r *http.Request) { ready++; w.WriteHeader(http.StatusOK) }
+			s := newTestServer(local, newStubRouter(nil, ""))
+			s.cfg = config.Config{RequiredAPIKeys: []string{"secret"}, Models: map[string]config.ModelConfig{"m1": {}}, Upstream: config.UpstreamConfig{ObservabilityPaths: tc.paths}}
+			s.routes()
+			r := httptest.NewRequest(tc.method, tc.path, nil)
+			if tc.key != "" {
+				r.Header.Set("Authorization", "Bearer "+tc.key)
+			}
+			w := httptest.NewRecorder()
+			s.ServeHTTP(w, r)
+			if w.Code != tc.status {
+				t.Fatalf("status=%d expected=%d body=%q", w.Code, tc.status, w.Body.String())
+			}
+			if tc.status == http.StatusOK && (ready != 1 || ordinary != 0) {
+				t.Fatalf("ready=%d ordinary=%d", ready, ordinary)
+			}
+			if tc.status == http.StatusTooManyRequests && (ready != 0 || ordinary != 1) {
+				t.Fatalf("ready=%d ordinary=%d", ready, ordinary)
+			}
+			if tc.status == http.StatusUnauthorized && (ready != 0 || ordinary != 0) {
+				t.Fatalf("unauthorized request reached router: ready=%d ordinary=%d", ready, ordinary)
+			}
+		})
+	}
+}
