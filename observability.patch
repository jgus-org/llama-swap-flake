+++ b/internal/process/observability.go
@@ -0,0 +1,19 @@
+package process
+
+import (
+	"fmt"
+	"net/http"
+)
+
+func (p *ProcessCommand) ServeReadyHTTP(w http.ResponseWriter, r *http.Request) {
+	p.serveReady(w, r, p.State())
+}
+
+func (p *ProcessCommand) serveReady(w http.ResponseWriter, r *http.Request, state ProcessState) {
+	fn := p.handler.Load()
+	if state != StateReady || fn == nil {
+		http.Error(w, fmt.Sprintf("llama-swap-error: [%s] process is not ready", p.id), http.StatusServiceUnavailable)
+		return
+	}
+	(*fn)(w, r)
+}
diff --git a/internal/process/observability_test.go b/internal/process/observability_test.go
