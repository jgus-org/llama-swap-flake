+// newFIFOWithModels builds a FIFO with every model ready to serve, taking
+// configs from the caller so a test can see which limit governs admission.
+func newFIFOWithModels(t *testing.T, models map[string]config.ModelConfig) (*FIFO, *fakeEffects) {
+	t.Helper()
+	eff := newFakeEffects()
+	for model := range models {
+		eff.states[model] = process.StateReady
+	}
+	s := NewFIFO("test", logmon.NewWriter(io.Discard), &stubPlanner{}, config.FifoConfig{}, models, eff)
+	return s, eff
+}
+
+// TestFIFO_PriorityConcurrency_BurstDoesNotShedMoreUrgent: a model whose cap is
+// full of low-urgency traffic still admits a more urgent request.
+func TestFIFO_PriorityConcurrency_BurstDoesNotShedMoreUrgent(t *testing.T) {
+	// concurrencyLimit 1 next to priorityConcurrencyLimit 3 so a request admitted
+	// past the first can only be the priority cap's doing.
+	s, eff := newFIFOWithModels(t, map[string]config.ModelConfig{
+		"a": {ConcurrencyLimit: 1, PriorityConcurrencyLimit: 3},
+	})
+
+	for range 3 {
+		r := reqPrio("a", 10)
+		s.OnRequest(r)
+		assertAdmitted(t, r)
+	}
+	if got := eff.served("a"); got != 3 {
+		t.Fatalf("served(a)=%d want 3", got)
+	}
+
+	// The burst fills the cap for its own priority and anything less urgent.
+	for _, priority := range []int{10, 50} {
+		r := reqPrio("a", priority)
+		s.OnRequest(r)
+		assertAdmission429(t, r)
+	}
+
+	// A more urgent request sees no reservation at all in its way.
+	urgent := reqPrio("a", -1)
+	s.OnRequest(urgent)
+	assertAdmitted(t, urgent)
+
+	// Each priority still gets only its own share of the cap.
+	for range 2 {
+		r := reqPrio("a", -1)
+		s.OnRequest(r)
+		assertAdmitted(t, r)
+	}
+	full := reqPrio("a", -1)
+	s.OnRequest(full)
+	assertAdmission429(t, full)
+}
+
+func TestFIFO_PriorityConcurrency_EqualPriorityBlocksItsOwnKind(t *testing.T) {
+	s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{
+		"a": {PriorityConcurrencyLimit: 2},
+	})
+
+	first := reqPrio("a", 0)
+	second := reqPrio("a", 0)
+	s.OnRequest(first)
+	s.OnRequest(second)
+	assertAdmitted(t, first)
+	assertAdmitted(t, second)
+
+	third := reqPrio("a", 0)
+	s.OnRequest(third)
+	assertAdmission429(t, third)
+
+	// A served request gives its bucket's slot back to its own priority.
+	s.OnServeDone(ServeDoneEvent{ModelID: "a", Priority: 0})
+	fourth := reqPrio("a", 0)
+	s.OnRequest(fourth)
+	assertAdmitted(t, fourth)
+}
+
+func TestFIFO_PriorityConcurrency_AbsentPriorityIsZeroAndNegativeIsUrgent(t *testing.T) {
+	s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{
+		"a": {PriorityConcurrencyLimit: 1},
+	})
+
+	silent := req("a")
+	s.OnRequest(silent)
+	assertAdmitted(t, silent)
+
+	// A silent request and an explicit 0 are the same priority, so both shed.
+	for _, r := range []HandlerReq{req("a"), reqPrio("a", 0)} {
+		s.OnRequest(r)
+		assertAdmission429(t, r)
+	}
+
+	// A negative priority is more urgent than 0.
+	urgent := reqPrio("a", -1)
+	s.OnRequest(urgent)
+	assertAdmitted(t, urgent)
+}
+
+// TestFIFO_PriorityConcurrency_ReleasePaths walks every site that returns a
+// reservation. One aimed at the wrong bucket panics rather than drifting.
+func TestFIFO_PriorityConcurrency_ReleasePaths(t *testing.T) {
+	t.Run("serve completion", func(t *testing.T) {
+		s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{
+			"a": {PriorityConcurrencyLimit: 1},
+		})
+
+		serving := reqPrio("a", 7)
+		s.OnRequest(serving)
+		assertAdmitted(t, serving)
+
+		blocked := reqPrio("a", 7)
+		s.OnRequest(blocked)
+		assertAdmission429(t, blocked)
+
+		s.OnServeDone(ServeDoneEvent{ModelID: "a", Priority: 7})
+
+		after := reqPrio("a", 7)
+		s.OnRequest(after)
+		assertAdmitted(t, after)
+	})
+
+	t.Run("cancel while queued", func(t *testing.T) {
+		eff := newFakeEffects()
+		eff.states["a"] = process.StateStopped
+		eff.states["b"] = process.StateStopped
+		models := map[string]config.ModelConfig{
+			"a": {PriorityConcurrencyLimit: 1},
+			"b": {},
+		}
+		planner := &stubPlanner{evict: map[string][]string{"a": {"b"}}}
+		s := NewFIFO("test", logmon.NewWriter(io.Discard), planner, config.FifoConfig{}, models, eff)
+
+		bReq := req("b")
+		cancelled := reqChPrio("a", 4)
+		rejected := reqPrio("a", 4)
+		s.OnRequest(bReq)
+		s.OnRequest(cancelled)
+		s.OnRequest(rejected)
+		assertAdmitted(t, bReq)
+		assertAdmitted(t, cancelled)
+		assertAdmission429(t, rejected)
+
+		s.OnCancel(cancelled)
+
+		retry := reqPrio("a", 4)
+		s.OnRequest(retry)
+		assertAdmitted(t, retry)
+	})
+
+	t.Run("cancel while waiting on a swap", func(t *testing.T) {
+		eff := newFakeEffects()
+		eff.states["a"] = process.StateStopped
+		models := map[string]config.ModelConfig{
+			"a": {PriorityConcurrencyLimit: 2},
+		}
+		s := NewFIFO("test", logmon.NewWriter(io.Discard), &stubPlanner{}, config.FifoConfig{}, models, eff)
+
+		starter := reqPrio("a", 3)
+		waiter := reqChPrio("a", 3)
+		s.OnRequest(starter)
+		s.OnRequest(waiter)
+		assertAdmitted(t, starter)
+		assertAdmitted(t, waiter)
+		if sw := s.active["a"]; len(sw.waiters) != 2 {
+			t.Fatalf("waiters=%d want 2", len(sw.waiters))
+		}
+
+		s.OnCancel(waiter)
+
+		// One slot came back to the bucket, and only one.
+		replacement := reqPrio("a", 3)
+		s.OnRequest(replacement)
+		assertAdmitted(t, replacement)
+		if sw := s.active["a"]; len(sw.waiters) != 2 {
+			t.Fatalf("waiters=%d want 2 after the replacement joined", len(sw.waiters))
+		}
+
+		over := reqPrio("a", 3)
+		s.OnRequest(over)
+		assertAdmission429(t, over)
+	})
+}
+
+// TestFIFO_PriorityConcurrency_UniformPriorityMatchesFlatLimit: when every
+// request states the same priority the prefix rule is the flat count.
+func TestFIFO_PriorityConcurrency_UniformPriorityMatchesFlatLimit(t *testing.T) {
+	const limit = 3
+
+	run := func(t *testing.T, models map[string]config.ModelConfig) []bool {
+		t.Helper()
+		s, _ := newFIFOWithModels(t, models)
+
+		var admitted []bool
+		attempt := func() {
+			r := reqPrio("a", 0)
+			s.OnRequest(r)
+			admitted = append(admitted, admitErr(t, r) == nil)
+		}
+
+		attempt()
+		attempt()
+		attempt()
+		attempt()
+		s.OnServeDone(ServeDoneEvent{ModelID: "a"})
+		attempt()
+		s.OnServeDone(ServeDoneEvent{ModelID: "a"})
+		s.OnServeDone(ServeDoneEvent{ModelID: "a"})
+		for range 3 {
+			attempt()
+		}
+		return admitted
+	}
+
+	priorityCapped := run(t, map[string]config.ModelConfig{"a": {PriorityConcurrencyLimit: limit}})
+	flat := run(t, map[string]config.ModelConfig{"a": {ConcurrencyLimit: limit}})
+
+	if want := []bool{true, true, true, false, true, true, true, false}; !slices.Equal(priorityCapped, want) {
+		t.Fatalf("priority-capped admissions = %v, want %v", priorityCapped, want)
+	}
+	if !slices.Equal(priorityCapped, flat) {
+		t.Fatalf("admissions differ: priority-capped %v, flat %v", priorityCapped, flat)
+	}
+}
+
+// TestFIFO_PriorityConcurrency_OptInOnly: the cap governs only models that set it.
+func TestFIFO_PriorityConcurrency_OptInOnly(t *testing.T) {
+	t.Run("concurrencyLimit governs when the key is absent", func(t *testing.T) {
+		s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{"a": {ConcurrencyLimit: 1}})
+
+		admitAndAssert(t, s, req("a"))
+
+		urgent := reqPrio("a", -100)
+		s.OnRequest(urgent)
+		assertAdmission429(t, urgent)
+	})
+
+	t.Run("zero value leaves concurrencyLimit in charge", func(t *testing.T) {
+		s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{
+			"a": {ConcurrencyLimit: 1, PriorityConcurrencyLimit: 0},
+		})
+
+		admitAndAssert(t, s, req("a"))
+
+		urgent := reqPrio("a", -100)
+		s.OnRequest(urgent)
+		assertAdmission429(t, urgent)
+	})
+
+	t.Run("default of ten still applies", func(t *testing.T) {
+		s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{"a": {}})
+
+		for range 10 {
+			admitAndAssert(t, s, req("a"))
+		}
+		over := reqPrio("a", -100)
+		s.OnRequest(over)
+		assertAdmission429(t, over)
+	})
+
+	t.Run("priorityConcurrencyLimit wins when both are set", func(t *testing.T) {
+		s, _ := newFIFOWithModels(t, map[string]config.ModelConfig{
+			"a": {ConcurrencyLimit: 1, PriorityConcurrencyLimit: 2},
+		})
+
+		// concurrencyLimit would have shed this second request.
+		admitAndAssert(t, s, reqPrio("a", 0))
+		admitAndAssert(t, s, reqPrio("a", 0))
+
+		over := reqPrio("a", 0)
+		s.OnRequest(over)
+		assertAdmission429(t, over)
+	})
+}
+
+func admitAndAssert(t *testing.T, s *FIFO, r HandlerReq) {
+	t.Helper()
+	s.OnRequest(r)
+	assertAdmitted(t, r)
+}
