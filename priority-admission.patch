+
+		req := jsonRequest(t, cfg, `{"model":"other","priority":9}`)
+		got := runPriorityMiddleware(t, cfg, req)
+		if got.priority != 0 {
+			t.Errorf("priority = %d, want 0 for a model with no priorityConcurrencyLimit", got.priority)
+		}
+	})
+
+	t.Run("request with no cached context", func(t *testing.T) {
+		cfg := optedInConfig(4)
+
+		reached := false
+		next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { reached = true })
+		req := httptest.NewRequest("POST", "/v1/chat/completions", bytes.NewBufferString(`{"model":"llama","priority":3}`))
+		req.Header.Set("Content-Type", "application/json")
+
+		chain.New(CreatePriorityMiddleware(cfg)).Then(next).ServeHTTP(httptest.NewRecorder(), req)
+		if !reached {
+			t.Error("request with no cached context did not reach the next handler")
+		}
+	})
+}
