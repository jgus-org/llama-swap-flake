@@ -0,0 +1,67 @@
+package server
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/mostlygeek/llama-swap/internal/chain"
+	"github.com/mostlygeek/llama-swap/internal/config"
+	"github.com/mostlygeek/llama-swap/internal/swaputil"
+	"github.com/tidwall/gjson"
+)
+
+// CreatePriorityMiddleware records the urgency a request states, so a model that
+// set priorityConcurrencyLimit can gate admission on it. It runs after the body
+// filters, so a server-side setParams stamp decides both admission and what the
+// backend sees.
+//
+// The buffered body is re-attached with Content-Length / Transfer-Encoding
+// cleanup so the reverse proxy forwards the correct bytes (see issue #11).
+func CreatePriorityMiddleware(cfg config.Config) chain.Middleware {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			data, ok := swaputil.ReadContext(r.Context())
+			if !ok {
+				next.ServeHTTP(w, r)
+				return
+			}
+
+			mc, ok := cfg.Models[data.ModelID]
+			if !ok || mc.PriorityConcurrencyLimit <= 0 {
+				next.ServeHTTP(w, r)
+				return
+			}
+
+			if !strings.Contains(r.Header.Get("Content-Type"), "application/json") {
+				next.ServeHTTP(w, r)
+				return
+			}
+
+			body, err := io.ReadAll(r.Body)
+			if err != nil {
+				swaputil.SendResponse(w, r, http.StatusBadRequest, "could not read request body")
+				return
+			}
+
+			data.Priority = jsonPriority(body)
+			r.Body = io.NopCloser(bytes.NewReader(body))
+			r.Header.Del("Transfer-Encoding")
+			r.Header.Set("Content-Length", strconv.Itoa(len(body)))
+			r.ContentLength = int64(len(body))
+
+			next.ServeHTTP(w, r.WithContext(swaputil.SetContext(r.Context(), data)))
+		})
+	}
+}
+
+// jsonPriority reads the "priority" field; anything but a whole JSON number is 0.
+func jsonPriority(body []byte) int {
+	value := gjson.GetBytes(body, "priority")
+	if value.Type != gjson.Number || strings.ContainsAny(value.Raw, ".eE") {
+		return 0
+	}
+	return int(value.Int())
+}
