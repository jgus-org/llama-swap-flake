+
+		got := runPriorityMiddleware(t, cfg, req)
+		if got.priority != 0 {
+			t.Errorf("priority = %d, want 0 for a non-JSON body", got.priority)
+		}
+		if got.readsBeforeHandler != 0 {
+			t.Errorf("middleware made %d reads on a non-JSON body", got.readsBeforeHandler)
+		}
+		if got.body != form {
+			t.Errorf("body downstream = %q, want the inherited body", got.body)
+		}
+	})
+
+	t.Run("unknown model", func(t *testing.T) {
+		cfg := optedInConfig(4)
