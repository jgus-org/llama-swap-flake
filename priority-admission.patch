+		req := httptest.NewRequest("POST", "/v1/chat/completions", bytes.NewBufferString(form))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		if _, err := swaputil.FetchContext(req, cfg); err != nil {
