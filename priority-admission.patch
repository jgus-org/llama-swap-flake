+package server
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/mostlygeek/llama-swap/internal/chain"
+	"github.com/mostlygeek/llama-swap/internal/config"
+	"github.com/mostlygeek/llama-swap/internal/swaputil"
+)
+
+// countingBody proves the middleware read the body it inherited.
+type countingBody struct {
+	io.Reader
+	reads int
+}
+
+func (b *countingBody) Read(p []byte) (int, error) {
+	b.reads++
+	return b.Reader.Read(p)
+}
+
+func (b *countingBody) Close() error { return nil }
+
+// priorityResult is what the middleware handed downstream. readsBeforeHandler
+// is measured before the handler runs, attributing any read to the middleware.
+type priorityResult struct {
+	priority           int
+	body               string
+	contentLength      string
+	bodyLength         int
+	readsBeforeHandler int
+	reached            bool
+}
+
+// runPriorityMiddleware feeds req through the middleware; body is the reader
+// it inherits.
+func runPriorityMiddleware(t *testing.T, cfg config.Config, req *http.Request) priorityResult {
+	t.Helper()
+
+	var result priorityResult
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, ok := swaputil.ReadContext(r.Context())
+		if !ok {
+			t.Error("downstream handler found no request context")
+			return
+		}
+		if body, ok := r.Body.(*countingBody); ok {
+			result.readsBeforeHandler = body.reads
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("downstream handler could not read body: %v", err)
+			return
+		}
+		result.priority = data.Priority
+		result.body = string(body)
+		result.contentLength = r.Header.Get("Content-Length")
+		result.bodyLength = int(r.ContentLength)
+		result.reached = true
+	})
+
+	chain.New(CreatePriorityMiddleware(cfg)).Then(next).ServeHTTP(httptest.NewRecorder(), req)
+	return result
+}
+
+// jsonRequest is a chat completion whose model FetchContext already resolved.
+func jsonRequest(t *testing.T, cfg config.Config, body string) *http.Request {
+	t.Helper()
+
+	req := httptest.NewRequest("POST", "/v1/chat/completions", bytes.NewBufferString(body))
+	req.Header.Set("Content-Type", "application/json")
+	if _, err := swaputil.FetchContext(req, cfg); err != nil {
+		t.Fatalf("FetchContext: %v", err)
+	}
+	return req
+}
+
+func optedInConfig(limit int) config.Config {
+	return config.Config{Models: map[string]config.ModelConfig{
+		"llama": {PriorityConcurrencyLimit: limit},
+	}}
+}
+
+func TestServer_PriorityMiddleware_readsBodyPriority(t *testing.T) {
+	cfg := optedInConfig(4)
+
+	for _, tc := range []struct {
+		name string
+		body string
+		want int
+	}{
+		{name: "stated priority", body: `{"model":"llama","priority":5}`, want: 5},
+		{name: "negative is more urgent, not unset", body: `{"model":"llama","priority":-3}`, want: -3},
+		{name: "explicit zero", body: `{"model":"llama","priority":0}`, want: 0},
+		{name: "absent", body: `{"model":"llama"}`, want: 0},
+		{name: "null", body: `{"model":"llama","priority":null}`, want: 0},
+		{name: "quoted number", body: `{"model":"llama","priority":"5"}`, want: 0},
+		{name: "boolean", body: `{"model":"llama","priority":true}`, want: 0},
+		{name: "fractional", body: `{"model":"llama","priority":1.5}`, want: 0},
+		{name: "exponent form", body: `{"model":"llama","priority":1e3}`, want: 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := runPriorityMiddleware(t, cfg, jsonRequest(t, cfg, tc.body))
+			if !got.reached {
+				t.Fatal("downstream handler was not reached")
+			}
+			if got.priority != tc.want {
+				t.Errorf("priority = %d, want %d", got.priority, tc.want)
+			}
+			if got.body != tc.body {
+				t.Errorf("body downstream = %q, want %q", got.body, tc.body)
+			}
+			if got.contentLength != strconv.Itoa(len(tc.body)) {
+				t.Errorf("Content-Length = %q, want %d", got.contentLength, len(tc.body))
+			}
+			if got.bodyLength != len(tc.body) {
+				t.Errorf("ContentLength = %d, want %d", got.bodyLength, len(tc.body))
+			}
+		})
+	}
+}
+
+func TestServer_PriorityMiddleware_afterFilters(t *testing.T) {
+	// Mounted after the filters, the middleware must record the server-side stamp
+	// rather than the value the client sent.
+	cfg := config.Config{Models: map[string]config.ModelConfig{
+		"llama": {
+			PriorityConcurrencyLimit: 4,
+			Filters: config.ModelFilters{Filters: config.Filters{
+				SetParams: map[string]any{"priority": 7},
+			}},
+		},
+	}}
+
+	req := jsonRequest(t, cfg, `{"model":"llama","priority":-9}`)
+
+	var got priorityResult
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, _ := swaputil.ReadContext(r.Context())
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("downstream handler could not read body: %v", err)
+			return
+		}
+		got = priorityResult{priority: data.Priority, body: string(body), reached: true}
+	})
+
+	chain.New(CreateFilterMiddleware(cfg), CreatePriorityMiddleware(cfg)).Then(next).ServeHTTP(httptest.NewRecorder(), req)
+
+	if !got.reached {
+		t.Fatal("downstream handler was not reached")
+	}
+	if got.priority != 7 {
+		t.Errorf("priority = %d, want the filter-stamped 7", got.priority)
+	}
+	if !bytes.Contains([]byte(got.body), []byte(`"priority":7`)) {
+		t.Errorf("body downstream = %q, want the stamped priority", got.body)
+	}
+}
+
+func TestServer_PriorityMiddleware_untouchedModelsAndBodies(t *testing.T) {
+	t.Run("model without the option set", func(t *testing.T) {
+		cfg := config.Config{Models: map[string]config.ModelConfig{"llama": {ConcurrencyLimit: 4}}}
+
+		req := jsonRequest(t, cfg, `{"model":"llama","priority":-3}`)
