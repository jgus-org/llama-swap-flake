+func priorityRequest(model string, priority int) *http.Request {
+	r := newRequest(model)
+	data := swaputil.ReqContextData{Model: model, ModelID: model, Priority: priority}
+	return r.WithContext(swaputil.SetContext(r.Context(), data))
+}
+
+// TestBaseRouter_PriorityConcurrencyCarriesPriorityThroughServe covers both
+// hand-offs base.go owns: the request it gives the scheduler and the completion
+// event that releases the reservation must carry the same priority.
+func TestBaseRouter_PriorityConcurrencyCarriesPriorityThroughServe(t *testing.T) {
+	conf := config.Config{
+		HealthCheckTimeout: 5,
+		Models:             map[string]config.ModelConfig{"a": {PriorityConcurrencyLimit: 1}},
+	}
+	a := newFakeProcess("a")
+	a.autoReady = true
+	a.serveBlock = make(chan struct{})
+
+	b := newTestBaseWithConfig(t, conf, map[string]process.Process{"a": a}, &stubPlanner{})
+
+	blocked := make(chan struct{})
+	go func() {
+		b.ServeHTTP(httptest.NewRecorder(), priorityRequest("a", 5))
+		close(blocked)
+	}()
+	waitSignal(t, a.serveStarted, "priority 5 request start")
+	waitProcessed(t, b.testProcessed, 1)
+
+	// The model is at capacity for that priority, so equal urgency is shed.
+	w := httptest.NewRecorder()
+	b.ServeHTTP(w, priorityRequest("a", 5))
+	if w.Code != http.StatusTooManyRequests {
+		t.Fatalf("status=%d want 429 body=%q", w.Code, w.Body.String())
+	}
+
+	// An urgent request gets in only because the router passed its priority on.
+	urgentW := httptest.NewRecorder()
+	urgent := make(chan struct{})
+	go func() {
+		b.ServeHTTP(urgentW, priorityRequest("a", -1))
+		close(urgent)
+	}()
+	waitProcessed(t, b.testProcessed, 1)
+
+	close(a.serveBlock)
+	waitSignal(t, blocked, "priority 5 request finish")
+	waitSignal(t, urgent, "urgent request finish")
+
+	// A finished request returns its slot, so the shed priority fits again.
+	w = httptest.NewRecorder()
+	b.ServeHTTP(w, priorityRequest("a", 5))
+	if w.Code != http.StatusOK {
+		t.Fatalf("status=%d want 200 body=%q", w.Code, w.Body.String())
+	}
+}
diff --git a/internal/router/scheduler/fifo.go b/internal/router/scheduler/fifo.go
index ea7d7f7..03ed40e 100644
--- a/internal/router/scheduler/fifo.go
+++ b/internal/router/scheduler/fifo.go
@@ -25,6 +25,72 @@ type activeSwap struct {
 	waiters    []HandlerReq
 }
 
+type prioBucket struct {
+	priority int
+	count    int
+}
+
+// reservations is a model's admitted-but-unfinished requests per priority, kept
+// in ascending priority order so the requests blocking a new one form a prefix.
+// A nil ledger and an absent map entry are both empty.
+type reservations struct {
+	buckets []prioBucket
+}
+
+// find returns priority's bucket index, or where it would sort if absent.
+func (r *reservations) find(priority int) int {
+	return sort.Search(len(r.buckets), func(i int) bool { return r.buckets[i].priority >= priority })
+}
+
+func (r *reservations) add(priority int) {
+	i := r.find(priority)
+	if i < len(r.buckets) && r.buckets[i].priority == priority {
+		r.buckets[i].count++
+		return
+	}
+	r.buckets = append(r.buckets, prioBucket{})
+	copy(r.buckets[i+1:], r.buckets[i:])
+	r.buckets[i] = prioBucket{priority: priority, count: 1}
+}
+
+// remove gives one reservation back, or reports false if priority holds none.
+func (r *reservations) remove(priority int) bool {
+	i := r.find(priority)
+	if i == len(r.buckets) || r.buckets[i].priority != priority {
+		return false
+	}
+	r.buckets[i].count--
+	if r.buckets[i].count == 0 {
+		r.buckets = append(r.buckets[:i], r.buckets[i+1:]...)
+	}
+	return true
+}
+
+func (r *reservations) atLeastAsUrgent(priority int) int {
+	if r == nil {
+		return 0
+	}
+	var n int
+	for _, b := range r.buckets {
+		if b.priority > priority {
+			break
+		}
+		n += b.count
+	}
+	return n
+}
+
+func (r *reservations) total() int {
+	if r == nil {
+		return 0
+	}
+	var n int
+	for _, b := range r.buckets {
+		n += b.count
+	}
+	return n
+}
+
